{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "OhPyBoy",
    "version": "1.0.0",
    "identifier": "com.fgvilches.ohpyboy",
    "build": {
        "frontendDist": "../src",
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": null
    },
    "app": {
        "windows": [
            {
                "title": "OhPyBoy",
                "width": 1280,
                "height": 820,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "transparent": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true
            }
        ],
        "security": {
            "csp": null
        },
        "withGlobalTauri": true,
        "macOSPrivateApi": true
    },
    "bundle": {
        "active": true,
        "targets": [
            "app",
            "dmg"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "category": "DeveloperTool",
        "shortDescription": "GBA emulator (Rust + Tauri)",
        "longDescription": "Browse and download 3DS titles from hShop with a native Liquid Glass interface.",
        "macOS": {
            "entitlements": "entitlements.plist"
        }
    }
}